{
  "rules": {
    "reservations": {
      ".read": true,
      ".indexOn": ["createdAt", "pickupDate", "status", "orderId"],
      "$orderId": {
        ".write": true,
        ".validate": "newData.hasChildren(['orderId'])"
      }
    },
    "inventory": {
      ".read": true,
      ".write": true
    },
    "config": {
      ".read": true,
      ".write": true
    },
    "otps": {
      ".read": true,
      ".write": true
    }
  }
}
